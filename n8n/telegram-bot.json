{
  "name": "Arka - Bot do Telegram",
  "nodes": [
    {
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "arka-telegram-bot",
      "parameters": {
        "updates": ["message"]
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot (Arka)"
        }
      }
    },
    {
      "id": "is-link-command",
      "name": "Is /vincular command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300],
      "parameters": {
        "conditions": {
          "boolean": [],
          "string": [
            {
              "value1": "={{$json[\"message\"][\"text\"] || \"\"}}",
              "operation": "startsWith",
              "value2": "/vincular "
            }
          ]
        }
      }
    },
    {
      "id": "normalize-link-payload",
      "name": "Normalize link payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [680, 480],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "telegramUserId",
              "value": "={{$json[\"message\"][\"from\"][\"id\"]}}"
            },
            {
              "name": "languageCode",
              "value": "={{$json[\"message\"][\"from\"][\"language_code\"]}}"
            },
            {
              "name": "chatId",
              "value": "={{$json[\"message\"][\"chat\"][\"id\"]}}"
            },
            {
              "name": "code",
              "value": "={{$json[\"message\"][\"text\"].split(\" \")[1]}}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "confirm-link",
      "name": "Confirm link (Python)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 480],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/telegram/link",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"telegramUserId\": $json.telegramUserId, \"languageCode\": $json.languageCode, \"chatId\": $json.chatId, \"code\": $json.code } }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "X-Service-Key (Arka)"
        }
      }
    },
    {
      "id": "has-photo",
      "name": "Has photo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300],
      "parameters": {
        "conditions": {
          "boolean": [],
          "string": [
            {
              "value1": "={{$json[\"message\"][\"photo\"] ? \"yes\" : \"no\"}}",
              "value2": "yes"
            }
          ]
        }
      }
    },
    {
      "id": "get-photo-file",
      "name": "Get photo file",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [680, 200],
      "parameters": {
        "resource": "file",
        "operation": "get",
        "fileId": "={{$json[\"message\"][\"photo\"][$json[\"message\"][\"photo\"].length - 1][\"file_id\"]}}",
        "download": true
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot (Arka)"
        }
      }
    },
    {
      "id": "normalize-photo-payload",
      "name": "Normalize photo payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200],
      "parameters": {
        "jsCode": "// O no Set com {{$binary.data.data}} saia sem a foto no n8n 1.100 (a imagem nao chegava ao OCR).\n// getBinaryDataBuffer le o binario baixado pelo no anterior em qualquer modo de armazenamento.\nconst trigger = $('Telegram Trigger').first().json;\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nreturn [{\n  json: {\n    telegramUserId: String(trigger.message.from.id),\n    languageCode: trigger.message.from.language_code ?? null,\n    chatId: String(trigger.message.chat.id),\n    photoBase64: buffer.toString('base64'),\n    telegramUpdateId: String(trigger.update_id),\n  },\n}];"
      }
    },
    {
      "id": "normalize-text-payload",
      "name": "Normalize text payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [680, 400],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "telegramUserId",
              "value": "={{$json[\"message\"][\"from\"][\"id\"]}}"
            },
            {
              "name": "languageCode",
              "value": "={{$json[\"message\"][\"from\"][\"language_code\"]}}"
            },
            {
              "name": "text",
              "value": "={{$json[\"message\"][\"text\"]}}"
            },
            {
              "name": "chatId",
              "value": "={{$json[\"message\"][\"chat\"][\"id\"]}}"
            },
            {
              "name": "telegramUpdateId",
              "value": "={{$json[\"update_id\"]}}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "capture-bet",
      "name": "Capture bet (Python)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/bets/capture",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"telegramUserId\": $json.telegramUserId, \"languageCode\": $json.languageCode, \"chatId\": $json.chatId, \"text\": $json.text, \"photoBase64\": $json.photoBase64, \"telegramUpdateId\": $json.telegramUpdateId } }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "X-Service-Key (Arka)"
        }
      }
    },
    {
      "id": "send-reply",
      "name": "Send reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1340, 300],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{$json[\"chatId\"]}}",
        "text": "={{$json[\"message\"]}}"
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot (Arka)"
        }
      }
    }
  ],
