{
  "name": "StakeVault - Bot do Telegram",
  "nodes": [
    {
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "stakevault-telegram-bot",
      "parameters": {
        "updates": ["message"]
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot (StakeVault)"
        }
      }
    },
    {
      "id": "is-link-command",
      "name": "Is /vincular command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300],
      "parameters": {
        "conditions": {
          "boolean": [],
          "string": [
            {
              "value1": "={{$json[\"message\"][\"text\"] || \"\"}}",
              "operation": "startsWith",
              "value2": "/vincular "
            }
          ]
        }
      }
    },
    {
      "id": "normalize-link-payload",
      "name": "Normalize link payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [680, 480],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "telegramUserId",
              "value": "={{$json[\"message\"][\"from\"][\"id\"]}}"
            },
            {
              "name": "languageCode",
              "value": "={{$json[\"message\"][\"from\"][\"language_code\"]}}"
            },
            {
              "name": "chatId",
              "value": "={{$json[\"message\"][\"chat\"][\"id\"]}}"
            },
            {
              "name": "code",
              "value": "={{$json[\"message\"][\"text\"].split(\" \")[1]}}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "confirm-link",
      "name": "Confirm link (Python)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 480],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/telegram/link",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"telegramUserId\": $json.telegramUserId, \"languageCode\": $json.languageCode, \"chatId\": $json.chatId, \"code\": $json.code } }}",
        "options": {}
      }
    },
    {
      "id": "has-photo",
      "name": "Has photo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300],
      "parameters": {
        "conditions": {
          "boolean": [],
          "string": [
            {
              "value1": "={{$json[\"message\"][\"photo\"] ? \"yes\" : \"no\"}}",
              "value2": "yes"
            }
          ]
        }
      }
    },
    {
      "id": "get-photo-file",
      "name": "Get photo file",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [680, 200],
      "parameters": {
        "resource": "file",
        "operation": "get",
        "fileId": "={{$json[\"message\"][\"photo\"][$json[\"message\"][\"photo\"].length - 1][\"file_id\"]}}",
        "download": true
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot (StakeVault)"
        }
      }
    },
    {
      "id": "normalize-photo-payload",
      "name": "Normalize photo payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [900, 200],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "telegramUserId",
              "value": "={{$node[\"Telegram Trigger\"].json[\"message\"][\"from\"][\"id\"]}}"
            },
            {
              "name": "languageCode",
              "value": "={{$node[\"Telegram Trigger\"].json[\"message\"][\"from\"][\"language_code\"]}}"
            },
            {
              "name": "chatId",
              "value": "={{$node[\"Telegram Trigger\"].json[\"message\"][\"chat\"][\"id\"]}}"
            },
            {
              "name": "photoBase64",
              "value": "={{$binary.data.data}}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "normalize-text-payload",
      "name": "Normalize text payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [680, 400],
      "parameters": {
        "values": {
          "string": [
            {
              "name": "telegramUserId",
              "value": "={{$json[\"message\"][\"from\"][\"id\"]}}"
            },
            {
              "name": "languageCode",
              "value": "={{$json[\"message\"][\"from\"][\"language_code\"]}}"
            },
            {
              "name": "text",
              "value": "={{$json[\"message\"][\"text\"]}}"
            },
            {
              "name": "chatId",
              "value": "={{$json[\"message\"][\"chat\"][\"id\"]}}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "capture-bet",
      "name": "Capture bet (Python)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/bets/capture",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"telegramUserId\": $json.telegramUserId, \"languageCode\": $json.languageCode, \"chatId\": $json.chatId, \"text\": $json.text, \"photoBase64\": $json.photoBase64 } }}",
        "options": {}
      }
    },
    {
      "id": "send-reply",
      "name": "Send reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1340, 300],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{$json[\"chatId\"]}}",
        "text": "={{$json[\"message\"]}}"
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot (StakeVault)"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Is /vincular command?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is /vincular command?": {
      "main": [
        [
          {
            "node": "Normalize link payload",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Has photo?",
            "type": "main",
            "index": 0
          }
        ]
      ]
