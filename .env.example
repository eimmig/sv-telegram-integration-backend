# Copie para .env (nunca versionado - ver .gitignore) e preencha os valores reais.
# Ver docs/OBSERVABILITY-AND-CONFIG.md. So variaveis que algum codigo deste servico realmente
# le - cada bloco abaixo documenta a feature que a introduziu.

# Conexao Redis (feat-002, estado do fallback conversacional de captura de aposta - nao cache).
# Mesma instancia ja provisionada em infra/docker-compose.yml (redis) para stats-service.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# URL do auth-service (feat-003, confirmacao de vinculo de conta Telegram - chamada direta,
# bypassa o api-gateway, ver docs/DECISIONS-LOG.md 2026-09-08). Porta 8081 e a porta HTTP fixa
# do auth-service (docs/DECISIONS-LOG.md 2026-09-07).
AUTH_SERVICE_URL=http://localhost:8081

# api-gateway (feat-004, catalogo de sport/league/market/betting-house + POST /api/v1/bets -
# unico caminho que passa pelo Gateway em vez de chamar um servico direto). Porta 8080 e a
# porta HTTP fixa do api-gateway (docs/DECISIONS-LOG.md 2026-09-07). SERVICE_KEY precisa bater
# com o mesmo segredo configurado em services/api-gateway (propriedade gateway.service-key).
# Mesmo valor tambem exigido no header X-Service-Key de quem CHAMA este servico (n8n) desde a
# feat-008 - reaproveitado, nao um segredo novo (ver n8n/README.md).
API_GATEWAY_URL=http://localhost:8080
SERVICE_KEY=CHANGE_ME
